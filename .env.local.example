# Copy to .env.local and fill in.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Cloudinary unsigned upload (admin frontend uploads images directly to Cloudinary).
# 1. Create a free Cloudinary account.
# 2. Settings > Upload > Add upload preset > Signing Mode: Unsigned.
# 3. Set a folder restriction (e.g. "Decor N Art") and a max file size.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
